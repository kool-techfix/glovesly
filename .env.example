# Copy to .env and fill in. Every variable without "(optional)" is required:
# src/instrumentation.ts validates them at server boot (rules in src/lib/env.ts).

# --- Database (PostgreSQL) -------------------------------------------------
# Runtime connection, used by the app through @prisma/adapter-pg.
# Use the pooled URL if your provider offers one (Neon, Supabase, ...).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/glovesly?schema=public"
# Direct (non-pooled) connection, used by the Prisma CLI for migrations.
# Same as DATABASE_URL if your provider has no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/glovesly?schema=public"
# (optional) Max connections per app instance. Set to 1 with `prisma dev`.
DATABASE_POOL_MAX=

# --- Auth ------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# --- App -------------------------------------------------------------------
# Public base URL, used in email links. No trailing slash.
APP_URL="http://localhost:3000"

# --- Cloudinary (signed direct uploads) ------------------------------------
# Letters, digits, "-" or "_".
CLOUDINARY_CLOUD_NAME=""
# Numeric.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email over SMTP (optional) --------------------------------------------
# Without SMTP_HOST, emails are printed to the log in development and skipped
# in production. EMAIL_FROM is required when SMTP_HOST is set; SMTP_USER and
# SMTP_PASS must be set together.
SMTP_HOST=
# 587 = STARTTLS (default), 465 = implicit TLS (set SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# e.g. "Glovesly Pro-Project <no-reply@example.com>"
EMAIL_FROM=

# --- Seed (optional, used by prisma/seed.ts) -------------------------------
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
