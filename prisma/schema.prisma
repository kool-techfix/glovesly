// Glovesly Pro-Project data model.
// Connection URLs live in prisma.config.ts (CLI) and src/lib/prisma.ts (runtime).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PasswordTokenPurpose {
  RESET
  INVITE
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ProjectSector {
  AVIATION
  CONSTRUCTION
  SECURITY
  ENERGY
}

enum ProjectStatus {
  ONGOING
  COMPLETED
}

// PROVISIONAL: these groups await the owner's final partner categories.
enum PartnerType {
  GOVERNMENT
  PRIVATE_CLIENT
  TECHNOLOGY_PARTNER
  INTERNATIONAL_PARTNER
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Accounts, sessions and audit
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  role         UserRole   @default(EDITOR)
  status       UserStatus @default(ACTIVE)
  /// Null until the invite is accepted and a password is set.
  passwordHash String?
  preferences  Json       @default("{}")
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions       Session[]
  passwordTokens PasswordToken[]
  activityLogs   ActivityLog[]
  newsPosts      NewsPost[]

  @@index([role, status])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordToken {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the raw token; the raw token is never stored.
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Single row with id "workspace".
model WorkspaceSettings {
  id              String   @id @default("workspace")
  contactEmail    String?
  phone           String?
  address         String?
  /// [{ name, state, latitude?, longitude?, isHeadOffice }]
  officeLocations Json     @default("[]")
  /// [{ label, value }]
  stats           Json     @default("[]")
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Content modules
// ---------------------------------------------------------------------------

model Service {
  id            String         @id @default(cuid())
  slug          String         @unique
  status        ContentStatus  @default(DRAFT)
  publishedAt   DateTime?
  sortOrder     Int            @default(0)
  title         String
  summary       String         @default("")
  body          String         @default("") @db.Text
  capabilities  String[]       @default([])
  /// Links the service to projects in the same sector (related projects on /services/[slug]).
  sector        ProjectSector?
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, sortOrder])
}

model Project {
  id                 String        @id @default(cuid())
  slug               String        @unique
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  sortOrder          Int           @default(0)
  title              String
  summary            String        @default("")
  body               String        @default("") @db.Text
  sector             ProjectSector
  client             String?
  locationLabel      String?
  /// One of NIGERIA_STATES (src/lib/nigeria-states.ts), validated in the app.
  state              String
  latitude           Float?
  longitude          Float?
  year               Int?
  projectStatus      ProjectStatus @default(ONGOING)
  coverImageUrl      String?
  coverImagePublicId String?
  galleryUrls        String[]      @default([])
  galleryPublicIds   String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([sector])
  @@index([state])
}

model NewsPost {
  id                 String        @id @default(cuid())
  slug               String        @unique
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  sortOrder          Int           @default(0)
  title              String
  excerpt            String        @default("")
  body               String        @default("") @db.Text
  coverImageUrl      String?
  coverImagePublicId String?
  authorId           String?
  author             User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags               String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([status, publishedAt])
  @@index([authorId])
}

model TeamMember {
  id            String        @id @default(cuid())
  slug          String        @unique
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  sortOrder     Int           @default(0)
  name          String
  role          String
  bio           String        @default("") @db.Text
  photoUrl      String?
  photoPublicId String?
  linkedinUrl   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Partner {
  id                 String        @id @default(cuid())
  slug               String        @unique
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  sortOrder          Int           @default(0)
  name               String
  /// Logo for LIGHT backgrounds (dark artwork). Used on the white logo cards.
  logoUrl            String?
  logoPublicId       String?
  /// Optional white or light version for DARK backgrounds.
  logoOnDarkUrl      String?
  logoOnDarkPublicId String?
  /// Intrinsic pixel size of logoUrl, to size carousel cards by aspect ratio.
  /// Unknown (null) for admin uploads; the UI falls back to a default width.
  logoWidth          Int?
  logoHeight         Int?
  websiteUrl         String?
  type               PartnerType
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Inbox
// ---------------------------------------------------------------------------

model ContactMessage {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  subject    String?
  message    String        @db.Text
  status     MessageStatus @default(NEW)
  replyDraft String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}
